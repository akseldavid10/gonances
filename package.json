{
  "name": "gonances",
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/prepare-standalone.mjs",
    "start": "node .next/standalone/server.js",
    "db:seed": "tsx prisma/seed.ts",
    "lint": "biome check",
    "format": "biome format --write",
    "test": "tsx --test src/lib/falseData.test.ts src/lib/transaction-validation.test.ts src/lib/password-policy.test.ts src/lib/date-only.test.ts src/lib/fetchWithAuth.test.ts src/lib/currency-conversion.test.ts src/lib/exchange-rate-provider.test.ts src/lib/historical-currency.test.ts src/lib/database-url.test.ts",
    "benchmark:api": "node scripts/benchmark-api.mjs",
    "benchmark:web": "lhci autorun",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@prisma/client-runtime-utils": "^7.10.0",
    "@vercel/analytics": "^2.0.1",
    "bcryptjs": "^3.0.3",
    "google-auth-library": "^11.0.2",
    "jose": "^6.2.12",
    "lucide-react": "^1.40.0",
    "next": "16.3.8",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@lhci/cli": "0.15.1",
    "@prisma/adapter-neon": "7.10.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv": "^17.4.2",
    "prisma": "7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  },
  "packageManager": "pnpm@12.11.2"
}
